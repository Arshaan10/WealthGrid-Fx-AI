// Whealth Grid Fx AI — desk schema (SQLite for local/dev).
// To use Postgres later: change provider to "postgresql", update DATABASE_URL, then `npx prisma db push`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  phone              String?   @unique
  passwordHash       String
  role               String    @default("USER") // USER | ADMIN
  blocked            Boolean   @default(false)
  emailVerified      DateTime?
  emailVerifyToken   String?
  emailVerifyExpires DateTime?
  walletAddress      String?
  referralCode       String    @unique
  referredById       String?
  referredBy         User?     @relation("UserReferrals", fields: [referredById], references: [id])
  downline           User[]    @relation("UserReferrals")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  wallets       WalletBalance[]
  ledger        LedgerEntry[]
  activations   PackageActivation[]
  referralsMade Referral[]          @relation("Referrer")
  referralsGot  Referral[]          @relation("Referee")
  rewardPayouts RewardPayout[]
  rankProgress  RankProgress?
  deposits          DepositIntent[]
  withdrawals       WithdrawalRequest[]
  announcements     Announcement[]
  auditLogs         AuditLog[]
  treasuryMoves     TreasuryMovement[]
  tickets           SupportTicket[]
  ticketMessages    SupportMessage[]
}

model WalletBalance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // TRADING | NETWORK
  available Decimal  @default(0)
  pending   Decimal  @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
}

model LedgerEntry {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletType   String
  direction    String // CREDIT | DEBIT
  category     String // DEPOSIT | WITHDRAWAL | PACKAGE | REWARD | ADJUSTMENT | REFERRAL | FEE
  amount       Decimal
  balanceAfter Decimal
  description  String
  refId        String?
  createdAt    DateTime @default(now())
}

model Package {
  id          String              @id @default(cuid())
  slug        String              @unique
  name        String
  minAmount   Decimal
  dailyRate   Decimal
  maxReturn   Decimal
  networkCap  Decimal
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  activations PackageActivation[]
}

model PackageActivation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId String
  package   Package   @relation(fields: [packageId], references: [id])
  amount    Decimal
  status    String    @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  startedAt DateTime  @default(now())
  endsAt    DateTime?
}

model Referral {
  id         String   @id @default(cuid())
  referrerId String
  referrer   User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId  String
  referee    User     @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)
  level      Int      @default(1)
  createdAt  DateTime @default(now())

  @@unique([referrerId, refereeId])
}

model RewardPayout {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // DAILY | DIRECT | TEAM | RANK | LOYALTY | TURNOVER
  amount    Decimal
  status    String   @default("PENDING") // PENDING | PAID | CANCELLED
  note      String?
  /** Idempotency key, e.g. DAILY:2026-09-12 or TEAM:2026-09-12:<sourceUserId> */
  periodKey String?
  createdAt DateTime @default(now())

  @@index([userId, type, periodKey])
}

model RankProgress {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentRank     String   @default("NONE")
  teamVolume      Decimal  @default(0)
  personalVolume  Decimal  @default(0)
  updatedAt       DateTime @updatedAt
}

model DepositIntent {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal
  walletType  String    @default("TRADING")
  status      String    @default("PENDING") // PENDING | CONFIRMING | APPROVED | REJECTED
  txHint      String?
  fromAddress String?
  confirmations Int     @default(0)
  requiredConfs Int     @default(3)
  note        String?
  createdAt   DateTime  @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?

  @@index([txHint])
}

model WithdrawalRequest {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Decimal // gross deducted from the member wallet
  feeAmount  Decimal   @default(0)
  netAmount  Decimal   @default(0) // treasury payout after fee
  walletType String
  toAddress  String?
  status     String    @default("APPROVED") // PENDING (legacy) | APPROVED | SENDING | CONFIRMING | SENT | CONFIRMED | FAILED_SEND | REJECTED
  txHash     String?
  sendError  String?
  confirmations Int    @default(0)
  requiredConfs Int    @default(3)
  sentAt     DateTime?
  note       String?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  reviewedBy String?

  @@index([txHash])
}

model Treasury {
  id        String             @id @default("company")
  balance   Decimal            @default(0)
  updatedAt DateTime           @updatedAt
  movements TreasuryMovement[]
}

model TreasuryMovement {
  id           String   @id @default(cuid())
  treasuryId   String   @default("company")
  treasury     Treasury @relation(fields: [treasuryId], references: [id], onDelete: Cascade)
  direction    String // CREDIT | DEBIT
  category     String // TOPUP | PAYOUT | ADJUSTMENT
  amount       Decimal
  balanceAfter Decimal
  description  String
  refId        String?
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id])
  createdAt    DateTime @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  published Boolean  @default(true)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  status    String           @default("OPEN") // OPEN | PENDING | CLOSED
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  SupportMessage[]
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime      @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  meta      String?
  createdAt DateTime @default(now())
}
