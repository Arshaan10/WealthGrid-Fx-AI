# SQLite for local/dev. Point at Postgres later by changing provider in
# prisma/schema.prisma and this URL, then run `npx prisma db push`.
DATABASE_URL="file:./dev.db"

# NextAuth — generate a long random string for any shared/prod deploy.
NEXTAUTH_SECRET="phase1-dev-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"

# --- Wallet connect + company USDT rail ---
# Safer default is BSC testnet (97). Use 56 for BSC mainnet.
# Client-visible copies (NEXT_PUBLIC_*) are optional aliases; server names work too.
# The Web3 provider reads these from the server layout, so NEXT_PUBLIC_ is not required.
CHAIN_ID=97
RPC_URL="https://bsc-testnet-rpc.publicnode.com"
USDT_CONTRACT_ADDRESS=""
USDT_DECIMALS=18
COMPANY_WALLET_ADDRESS=""

# Server-only. Never commit a real key. Leave empty for DB-only auto-withdraw.
COMPANY_WALLET_PRIVATE_KEY=""

# WalletConnect Cloud project id (https://cloud.walletconnect.com).
# Injected wallets (MetaMask) work without this. QR connect needs it.
WALLETCONNECT_PROJECT_ID=""

# Blocks before deposit auto-credit or payout CONFIRMED.
# Default: 3 on BSC testnet (97), 15 on BSC mainnet (56).
CONFIRMATIONS_REQUIRED=3

# Optional public aliases if you prefer build-time client inlining:
# NEXT_PUBLIC_CHAIN_ID=97
# NEXT_PUBLIC_RPC_URL="https://bsc-testnet-rpc.publicnode.com"
# NEXT_PUBLIC_USDT_CONTRACT_ADDRESS=""
# NEXT_PUBLIC_COMPANY_WALLET_ADDRESS=""
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""
